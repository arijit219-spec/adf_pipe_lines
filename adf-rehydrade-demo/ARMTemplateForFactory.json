								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_Rehydration_List').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Rehydrate_Blob",
									"type": "WebActivity",
									"dependsOn": [],
